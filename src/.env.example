# ===== 人类操作者（法律责任人）=====
ALOS_OPERATOR_NAME=张三
ALOS_OPERATOR_EMAIL=you@example.com

# ===== LLM（OpenAI 兼容接口，留空则使用内置规则策略）=====
# OpenAI:   OPENAI_BASE_URL=https://api.openai.com/v1
# DeepSeek: OPENAI_BASE_URL=https://api.deepseek.com/v1
# 通义千问: OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Ollama:   OPENAI_BASE_URL=http://localhost:11434/v1 （无需 Key）
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# ===== 世界 =====
# sim = 内置模拟世界（默认，开箱即用）；qemu = 真实虚拟机（实验性）
ALOS_WORLD=sim
ALOS_TICK_MS=1500
ALOS_SEED=
# QEMU 模式：
# ALOS_QEMU_IMAGE=/path/to/ubuntu.qcow2
# ALOS_QMP_SOCKET=/tmp/qmp.sock     # 或连接已运行的 QEMU（-qmp unix:/tmp/qmp.sock,server,nowait）
# ALOS_VNC_WS_PORT=5701

# ===== 智能体桌面（第一人称电脑）=====
# 默认绑定内置沙盒桌面；off = 不绑定（经典任务板世界）。VNC 电脑请在「智能体桌面」页面添加（密码存系统钥匙串）
# ALOS_DESKTOP=sandbox
# OPENAI_VISION=1              # 0 = 不发截图，只发屏幕文字（仅沙盒有效）
# ALOS_CUA_SHOT_WIDTH=1280     # 发给视觉模型的截图宽度
# ALOS_CUA_RULES=1             # 即使配置了 LLM，沙盒也用规则回退

# ===== 支付 / 邮箱 / 电话 适配器（mock | stripe | agentmail | twilio）=====
ALOS_PAYMENT=mock
ALOS_EMAIL=mock
ALOS_PHONE=mock
# 自动批准阈值（美元，默认 0 = 每笔都要人工批准）
ALOS_AUTO_APPROVE_BELOW_USD=0

# Stripe（只接受测试密钥 sk_test_，需操作者账户开通 Issuing）
STRIPE_SECRET_KEY=
# AgentMail
AGENTMAIL_API_KEY=
# AGENTMAIL_INBOX_ID=   # 可选：复用已有收件箱
# Twilio（使用操作者已购买的号码）
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
